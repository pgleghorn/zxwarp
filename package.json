{
  "name": "zxwarp",
  "version": "0.4.0",
  "description": "ZX Spectrum web UI powered by JSSpeccy 3 and inspired by Qaop/JS",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-jsspeccy": "node scripts/fetch-jsspeccy.js && node scripts/patch-jsspeccy.js",
    "fetch-games": "node scripts/fetch-games-zxinfo.js",
    "fetch-games-catalog": "node scripts/fetch-games-zxinfo.js --catalog-only",
    "fetch-pokes": "node scripts/fetch-pokes.js",
    "fetch-usb-ids": "node scripts/fetch-usb-ids.js",
    "patch-jsspeccy": "node scripts/patch-jsspeccy.js",
    "build": "node scripts/build.js",
    "serve": "node scripts/serve.js",
    "start": "npm run build && npm run serve"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later"
}
